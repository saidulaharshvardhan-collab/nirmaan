PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (leave empty to use embedded in-memory database for zero-config demo)
MONGODB_URI=

# JWT Secrets
JWT_SECRET=gramutthan_super_secret_jwt_key_sih26043_2026
JWT_EXPIRES_IN=7d

# Demo Mode Configuration
DEMO_MODE=true
DEMO_AI_LATENCY_MS=600

# AI Provider Configuration ('demo', 'gemini', 'openai')
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# Deduplication similarity threshold (0.0 to 1.0)
DEDUP_SIMILARITY_THRESHOLD=0.80

# File Upload Storage ('local', 'cloudinary')
STORAGE_TYPE=local
UPLOAD_DIR=uploads
